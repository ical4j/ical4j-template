{
  "name": "ical4j-template",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "npm run build-calendar && npm run build-vevent && npm run build-entity",
    "build-calendar": "npx @tailwindcss/cli -i ./calendar.css -o ../resources/public/calendar.css",
    "build-vevent": "npx @tailwindcss/cli -i ./vevent.css -o ../resources/public/vevent.css",
    "build-entity": "npx @tailwindcss/cli -i ./entity.css -o ../resources/public/entity.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.6",
    "tailwindcss": "^4.0.6"
  },
  "dependencies": {
    "flowbite": "^3.1.2",
    "minimal-request-promise": "^1.5.0",
    "tree-kill": "^1.2.2"
  }
}
